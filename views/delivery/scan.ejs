<div class="delivery-scanner">
    <h2 style="text-align:center;">Scan Order QR Code</h2>
    <p style="text-align:center;color:var(--gray-mid);margin-bottom:20px;">Point your camera at the order invoice QR code</p>

    <div id="scanner" style="width:100%;max-width:400px;margin:0 auto;border-radius:8px;overflow:hidden;background:#000;">
        <video id="scannerVideo" style="width:100%;display:block;" playsinline></video>
    </div>

    <div style="text-align:center;margin-top:16px;">
        <input type="text" id="manualQR" placeholder="Or enter QR code manually" style="padding:10px;border:2px solid var(--border-light);border-radius:4px;width:250px;">
        <button class="btn btn-primary btn-small" onclick="lookupOrder(document.getElementById('manualQR').value)">Lookup</button>
    </div>

    <!-- Order details (shown after scan) -->
    <div id="orderDetails" style="display:none;margin-top:30px;padding:20px;background:var(--gray-light);border-radius:8px;">
        <h3 id="orderIdDisplay"></h3>
        <div style="margin:12px 0;">
            <p><strong>Customer:</strong> <span id="customerName"></span></p>
            <p><strong>Status:</strong> <span id="orderStatus"></span></p>
        </div>
        <div id="orderItems" style="margin:12px 0;"></div>
        <div style="font-size:1.2rem;font-weight:800;margin:12px 0;">Total: ₹<span id="orderTotal"></span></div>
        <div id="orderActions" style="display:grid;gap:10px;margin-top:16px;">
            <button class="btn btn-primary btn-full" onclick="markShipped()">📦 Mark as Shipped</button>
            <button class="btn btn-primary btn-full" style="background:#4caf50;border-color:#4caf50;" onclick="showPaymentOptions()">💰 Deliver & Pay</button>
            <button class="btn btn-danger btn-full" onclick="cancelOrder()">✕ Cancel Order</button>
        </div>

        <!-- Payment modal -->
        <div id="paymentSection" style="display:none;margin-top:16px;padding:16px;background:#fff;border-radius:8px;">
            <h4 style="margin-bottom:12px;">Payment</h4>
            <div id="paymentButtons">
                <button class="btn btn-primary btn-full" style="margin-bottom:8px;background:#4caf50;border-color:#4caf50;" onclick="showUPIQR()">Pay with UPI (Show QR)</button>
                <button class="btn btn-secondary btn-full" style="margin-bottom:8px;" onclick="completeDelivery('cash')">Paid by Cash</button>
            </div>
            
            <!-- UPI QR Section -->
            <div id="upiQRSection" style="display:none;text-align:center;margin-top:12px;">
                <p style="font-weight:600;margin-bottom:8px;">Scan to pay to Admin:</p>
                <img id="upiQRImage" style="max-width:200px;margin:0 auto;display:block;" alt="UPI QR">
                <p style="font-size:0.85rem;color:var(--gray-mid);margin:8px 0;">UPI ID: prettypickles@ybl</p>
                <button class="btn btn-primary btn-full" style="margin-top:16px;" onclick="completeDelivery('upi')">Confirm Payment Received</button>
            </div>
        </div>
    </div>
</div>

<script>
let currentQR = '';
let currentOrderTotal = 0;
let currentOrderId = '';

async function lookupOrder(qrCode) {
    if (!qrCode) return;
    currentQR = qrCode;
    try {
        const res = await fetch('/delivery/api/order/' + qrCode);
        const order = await res.json();
        if (order.error) throw new Error(order.error);

        currentOrderTotal = order.totalAmount;
        currentOrderId = order.orderId;

        document.getElementById('orderDetails').style.display = 'block';
        document.getElementById('paymentSection').style.display = 'none';
        document.getElementById('upiQRSection').style.display = 'none';
        document.getElementById('paymentButtons').style.display = 'block';

        document.getElementById('orderIdDisplay').textContent = 'Order: ' + order.orderId;
        document.getElementById('customerName').textContent = order.customerName;
        document.getElementById('orderStatus').textContent = order.status;
        document.getElementById('orderTotal').textContent = order.totalAmount;
        document.getElementById('orderItems').innerHTML = order.items.map(item =>
            '<div style="margin:4px 0;font-size:0.9rem;">' + item.title + ' × ' + item.quantity + ' — ₹' + item.totalPrice + '</div>'
        ).join('');
    } catch (err) {
        alert(err.message || 'Order not found');
    }
}

function showPaymentOptions() {
    document.getElementById('paymentSection').style.display = 'block';
}

function showUPIQR() {
    const upiId = 'prettypickles@ybl';
    const name = 'PrettyPickles';
    const upiString = `upi://pay?pa=${upiId}&pn=${name}&am=${currentOrderTotal}&cu=INR&tn=Order_${currentOrderId}`;
    
    // Generate QR using Google Charts API
    const qrUrl = `https://chart.googleapis.com/chart?chs=200x200&cht=qr&chl=${encodeURIComponent(upiString)}`;
    
    document.getElementById('upiQRImage').src = qrUrl;
    document.getElementById('paymentButtons').style.display = 'none';
    document.getElementById('upiQRSection').style.display = 'block';
}

async function completeDelivery(type) {
    try {
        await fetchAPI('/delivery/api/order/' + currentQR + '/complete', {
            method: 'POST', body: JSON.stringify({ paymentType: type })
        });
        alert('Order completed!');
        location.reload();
    } catch (err) { alert(err.message); }
}

async function markShipped() {
    try {
        await fetchAPI('/delivery/api/order/' + currentQR + '/ship', { method: 'POST' });
        alert('Marked as shipped!');
        document.getElementById('orderStatus').textContent = 'shipped';
    } catch (err) { alert(err.message); }
}

async function cancelOrder() {
    if (!confirm('Cancel this order?')) return;
    try {
        await fetchAPI('/delivery/api/order/' + currentQR + '/complete', {
            method: 'POST', body: JSON.stringify({ paymentType: 'cancel' })
        });
        alert('Order cancelled');
        location.reload();
    } catch (err) { alert(err.message); }
}

// Camera scanner
(async function() {
    try {
        const video = document.getElementById('scannerVideo');
        const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        video.srcObject = stream;
        video.play();
        // QR scanning would use a library like jsQR in production
    } catch (err) { console.log('Camera not available'); }
})();
</script>
