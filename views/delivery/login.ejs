<div style="padding:30px 20px;max-width:400px;margin:0 auto;">
<h2 style="text-align:center;">Delivery Login</h2>
<% if (error) { %><div style="background:#fff0f0;color:#d32f2f;padding:10px;border-radius:4px;margin:16px 0;text-align:center;font-size:0.85rem;"><%= error %></div><% } %>
<form method="POST" action="/delivery/login">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
<div class="form-group"><label>Email</label><input type="email" name="email" required autofocus></div>
<div class="form-group"><label>Password</label><input type="password" name="password" required></div>
<button type="submit" class="btn btn-primary btn-full" style="background:#000;border-color:#000;">Login</button>
</form></div>
