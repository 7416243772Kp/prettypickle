<div class="container" style="padding:30px 20px;max-width:800px;">
<h1 class="page-title">Contact Us</h1>
<% if (typeof success !== 'undefined' && success) { %><div class="alert-success" style="background:#f0fff0;padding:12px;border:1px solid #4caf50;border-radius:4px;margin-bottom:20px;"><%= success %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert-error" style="background:#fff0f0;padding:12px;border:1px solid #f44;border-radius:4px;margin-bottom:20px;"><%= error %></div><% } %>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:30px;">
<div><h3 style="margin-bottom:16px;">Get in Touch</h3>
<p style="margin-bottom:12px;">📧 <a href="mailto:contact@prettypickles.com">contact@prettypickles.com</a></p>
<p style="margin-bottom:12px;">📍 Hyderabad, Telangana, India</p>
<p style="margin-bottom:12px;">⏰ Mon-Sat, 10:00 AM - 7:00 PM IST</p>
</div>
<form method="POST" action="/contact">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-group"><label>Email</label><input type="email" name="email" required></div>
<div class="form-group"><label>Message</label><textarea name="message" rows="5" required minlength="20"></textarea></div>
<button type="submit" class="btn btn-primary">Send Message</button>
</form></div></div>
