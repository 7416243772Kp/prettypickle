<div class="container cart-page">
    <h1 class="page-title">Shopping Cart</h1>
    <% if (!cart.items || cart.items.length === 0) { %>
        <div class="error-page" style="min-height:30vh;">
            <p>Your cart is empty</p>
            <a href="/" class="btn btn-primary mt-20">Continue Shopping</a>
        </div>
    <% } else { %>
    <div class="cart-layout">
        <div class="cart-items">
            <% cart.items.forEach(function(item) { %>
                <%
                    var itemId = item._id.toString();
                    var itemQty = item.quantity;
                    var itemImage = (item.product.images && item.product.images[0]) ? '/images/uploads/' + item.product.images[0] : '/images/placeholder-product.png';
                    var itemTotal = item.unitPrice * item.quantity;
                %>
                <div class="cart-item" data-item-id="<%= itemId %>">
                    <div class="cart-item-image">
                        <img src="<%= itemImage %>" alt="<%= item.product.title %>">
                    </div>
                    <div class="cart-item-info">
                        <div class="cart-item-title">
                            <a href="/product/<%= item.product.slug %>"><%= item.product.title %></a>
                        </div>
                        <div class="cart-item-variant">
                            <%= item.variant ? item.variant + ' · ' : '' %><%= item.weight %>
                        </div>
                        <div class="quantity-controls" style="margin:8px 0;">
                            <button class="qty-btn" data-id="<%= itemId %>" data-action="decrease" data-qty="<%= itemQty - 1 %>">−</button>
                            <input type="text" value="<%= itemQty %>" readonly style="width:40px;height:34px;">
                            <button class="qty-btn" data-id="<%= itemId %>" data-action="increase" data-qty="<%= itemQty + 1 %>">+</button>
                        </div>
                        <div class="cart-item-price">₹<%= itemTotal %></div>
                        <div class="cart-item-remove" data-id="<%= itemId %>">✕ Remove</div>
                    </div>
                </div>
            <% }) %>
        </div>

        <% var cartTotal = cart.getTotal(); %>
        <div class="cart-summary">
            <h3>Order Summary</h3>
            <div class="cart-summary-row">
                <span>Subtotal</span>
                <span id="cartSubtotal">₹<%= cartTotal %></span>
            </div>
            <div class="cart-summary-row">
                <span>Delivery</span>
                <span>Calculated at checkout</span>
            </div>
            <div class="cart-summary-row total">
                <span>Total</span>
                <span id="cartTotal">₹<%= cartTotal %></span>
            </div>
            <p style="font-size:0.75rem;color:var(--gray-mid);margin-top:6px;">Inclusive of all taxes</p>
            <a href="/orders/checkout/page" class="btn btn-primary btn-full mt-20">Proceed to Checkout</a>
            <a href="/" class="btn btn-secondary btn-full mt-10">Continue Shopping</a>
        </div>
    </div>
    <% } %>
</div>

<script>
// Quantity buttons
document.querySelectorAll('.qty-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var itemId = this.getAttribute('data-id');
        var qty = parseInt(this.getAttribute('data-qty'));
        updateCartItem(itemId, qty);
    });
});

// Remove buttons
document.querySelectorAll('.cart-item-remove').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var itemId = this.getAttribute('data-id');
        removeCartItem(itemId);
    });
});

async function updateCartItem(itemId, qty) {
    if (qty < 1) return removeCartItem(itemId);
    if (qty > 100) { showToast('Max 100 items', 'warning'); return; }
    try {
        await fetchAPI('/cart/update', { method: 'PUT', body: JSON.stringify({ itemId: itemId, quantity: qty }) });
        location.reload();
    } catch (err) { showToast(err.message, 'error'); }
}

async function removeCartItem(itemId) {
    try {
        await fetchAPI('/cart/remove/' + itemId, { method: 'DELETE' });
        var el = document.querySelector('[data-item-id="' + itemId + '"]');
        if (el) el.remove();
        showToast('Item removed');
        setTimeout(function() { location.reload(); }, 500);
    } catch (err) { showToast(err.message, 'error'); }
}
</script>
