<div class="container" style="padding:30px 20px;">
<h1 class="page-title">All Categories</h1>
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
<% categories.forEach(cat => { %>
<a href="/category/<%= cat.slug %>" class="category-chip" style="display:block;text-align:center;padding:20px;border-radius:8px;border:2px solid var(--border-light);font-size:1rem;font-weight:600;">
<%= cat.name %><% if (cat.description) { %><div style="font-size:0.8rem;font-weight:400;color:var(--gray-mid);margin-top:4px;"><%= cat.description %></div><% } %>
</a>
<% }) %>
</div></div>
