<div class="container orders-page">
    <h1 class="page-title">My Orders</h1>
    <% if (orders.length === 0) { %>
        <div class="error-page" style="min-height:30vh;"><p>No orders yet</p><a href="/" class="btn btn-primary mt-20">Start Shopping</a></div>
    <% } else { %>
        <% orders.forEach(order => { %>
        <div class="order-card" onclick="window.location.href='/orders/<%= order.orderId %>'">
            <div class="order-card-header">
                <div><strong><%= order.orderId %></strong><br><span style="font-size:0.8rem;color:var(--gray-mid);"><%= new Date(order.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span></div>
                <span class="order-status <%= order.status %>"><%= order.status %></span>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <% order.items.forEach(item => { %>
                    <div style="font-size:0.85rem;"><%= item.title.substring(0,30) %> × <%= item.quantity %></div>
                <% }) %>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px;">
                <strong>₹<%= order.totalAmount %></strong>
                <button class="btn btn-small btn-secondary" onclick="event.stopPropagation();reorder('<%= order.orderId %>')">Reorder</button>
            </div>
        </div>
        <% }) %>
    <% } %>
</div>
<script>
async function reorder(orderId) {
    try { await fetchAPI('/orders/reorder/' + orderId, { method: 'POST' }); showToast('Items added to cart!'); setTimeout(() => window.location.href = '/cart', 1000); }
    catch (err) { showToast(err.message, 'error'); }
}
</script>
