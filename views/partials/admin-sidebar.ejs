<aside class="admin-sidebar" id="adminSidebar">
    <div class="admin-sidebar-logo">
        ⚙️ Pretty Pickles<br>
        <span style="font-size:0.7rem;font-weight:400;opacity:0.6;">Admin Panel</span>
    </div>

    <a href="/admin/dashboard" class="<%= currentPath === '/admin/dashboard' ? 'active' : '' %>">📊 Dashboard</a>
    <a href="/admin/products" class="<%= currentPath.startsWith('/admin/products') ? 'active' : '' %>">📦 Products</a>
    <a href="/admin/categories" class="<%= currentPath.startsWith('/admin/categories') ? 'active' : '' %>">📁 Categories</a>
    <a href="/admin/orders" class="<%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>">🧾 Orders</a>
    <a href="/admin/coupons" class="<%= currentPath.startsWith('/admin/coupons') ? 'active' : '' %>">🏷️ Coupons</a>
    <a href="/admin/promoters" class="<%= currentPath.startsWith('/admin/promoters') ? 'active' : '' %>">💰 Promoters</a>
    <a href="/admin/bundles" class="<%= currentPath.startsWith('/admin/bundles') ? 'active' : '' %>">🎁 Bundles</a>
    <a href="/admin/banners" class="<%= currentPath.startsWith('/admin/banners') ? 'active' : '' %>">🖼️ Banners</a>
    <a href="/admin/delivery" class="<%= currentPath.startsWith('/admin/delivery') ? 'active' : '' %>">🚚 Delivery</a>
    <a href="/admin/analytics" class="<%= currentPath.startsWith('/admin/analytics') ? 'active' : '' %>">📈 Analytics</a>
    <a href="/admin/settings" class="<%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>">⚙️ Settings</a>

    <% if (typeof admin !== 'undefined' && admin && admin.role === 'primary') { %>
        <a href="/admin/admins" class="<%= currentPath.startsWith('/admin/admins') ? 'active' : '' %>" style="border-top:1px solid rgba(255,255,255,0.1);margin-top:10px;padding-top:16px;">👥 Manage Admins</a>
    <% } %>

    <a href="/admin/logout" style="border-top:1px solid rgba(255,255,255,0.1);margin-top:auto;padding-top:16px;color:rgba(255,255,255,0.4);">🚪 Logout</a>
</aside>

<!-- Mobile toggle button for admin sidebar -->
<button id="adminMenuToggle" style="display:none;position:fixed;top:16px;left:16px;z-index:101;background:#000;color:#fff;border:none;border-radius:4px;padding:8px 12px;cursor:pointer;font-size:1.2rem;">☰</button>

<style>
    @media (max-width: 768px) {
        #adminMenuToggle { display: block !important; }
    }
</style>
