<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Admin Login — Pretty Pickles</title>
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
<div class="admin-login-page" style="display:flex;align-items:center;justify-content:center;min-height:100vh;background:#f5f5f5;">
<div class="admin-login-box" style="background:#fff;padding:40px;border-radius:8px;width:100%;max-width:400px;box-shadow:0 2px 20px rgba(0,0,0,0.08);">
<h1 style="text-align:center;font-size:1.5rem;margin-bottom:8px;">Pretty Pickles</h1>
<p style="text-align:center;color:var(--gray-mid);margin-bottom:30px;">Admin Panel</p>

<% if (error) { %><div style="background:#fff0f0;color:#d32f2f;padding:10px;border-radius:4px;margin-bottom:16px;font-size:0.85rem;text-align:center;"><%= error %></div><% } %>

<% if (step === 'login') { %>
<form method="POST" action="/admin-login">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div class="form-group"><label>Email</label><input type="email" name="email" required autofocus></div>
    <div class="form-group"><label>Password</label><input type="password" name="password" required></div>
    <button type="submit" class="btn btn-primary btn-full" style="background:#000;border-color:#000;">Login</button>
</form>

<% } else if (step === 'setup-totp') { %>
<div style="text-align:center;">
    <p style="margin-bottom:16px;font-weight:600;">Setup Two-Factor Authentication</p>
    <p style="font-size:0.85rem;color:var(--gray-mid);margin-bottom:16px;">Scan this QR code with your authenticator app (Google Authenticator, Authy, etc.)</p>
    <img src="<%= qrCode %>" alt="TOTP QR Code" style="width:200px;height:200px;margin-bottom:16px;">
    <p style="font-size:0.75rem;color:var(--gray-mid);margin-bottom:20px;">Manual key: <code style="background:#f5f5f5;padding:2px 6px;border-radius:2px;"><%= secret %></code></p>
    <form method="POST" action="/admin-login/totp">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="form-group"><label>Enter TOTP Code</label><input type="text" name="totpCode" pattern="\d{6}" maxlength="6" placeholder="000000" required autofocus style="text-align:center;letter-spacing:6px;font-size:1.2rem;"></div>
        <button type="submit" class="btn btn-primary btn-full" style="background:#000;border-color:#000;">Verify & Enable</button>
    </form>
</div>

<% } else if (step === 'totp') { %>
<form method="POST" action="/admin-login/totp">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <p style="text-align:center;margin-bottom:16px;font-weight:600;">Enter TOTP Code</p>
    <p style="text-align:center;font-size:0.85rem;color:var(--gray-mid);margin-bottom:16px;">Enter the 6-digit code from your authenticator app</p>
    <div class="form-group"><input type="text" name="totpCode" pattern="\d{6}" maxlength="6" placeholder="000000" required autofocus style="text-align:center;letter-spacing:6px;font-size:1.2rem;"></div>
    <button type="submit" class="btn btn-primary btn-full" style="background:#000;border-color:#000;">Verify</button>
</form>
<% } %>
</div></div>
</body></html>
