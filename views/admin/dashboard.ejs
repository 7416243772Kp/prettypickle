<div class="admin-page">
<h1>Dashboard</h1>

<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:30px;">
    <div class="stat-card"><div class="stat-card-label">Today</div><div class="stat-card-value">₹<%= stats.todaySales?.toLocaleString('en-IN') || 0 %></div></div>
    <div class="stat-card"><div class="stat-card-label">Yesterday</div><div class="stat-card-value">₹<%= stats.yesterdaySales?.toLocaleString('en-IN') || 0 %></div></div>
    <div class="stat-card"><div class="stat-card-label">This Week</div><div class="stat-card-value">₹<%= stats.weekSales?.toLocaleString('en-IN') || 0 %></div></div>
    <div class="stat-card"><div class="stat-card-label">This Month</div><div class="stat-card-value">₹<%= stats.monthSales?.toLocaleString('en-IN') || 0 %></div></div>
</div>

<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:30px;">
    <div class="stat-card"><div class="stat-card-label">Last Month</div><div class="stat-card-value">₹<%= stats.lastMonthSales?.toLocaleString('en-IN') || 0 %></div></div>
    <div class="stat-card"><div class="stat-card-label">Total Sales</div><div class="stat-card-value">₹<%= stats.totalSales?.toLocaleString('en-IN') || 0 %></div></div>
    <div class="stat-card"><div class="stat-card-label">Total Orders</div><div class="stat-card-value"><%= stats.totalOrders || 0 %></div></div>
</div>

<div style="margin-bottom:30px;">
    <h3 style="margin-bottom:16px;">Sales Trend</h3>
    <canvas id="salesChart" height="80"></canvas>
</div>

<h3 style="margin-bottom:12px;">Recent Orders</h3>
<table class="admin-table">
    <thead><tr><th>Order ID</th><th>Customer</th><th>Amount</th><th>Payment</th><th>Status</th><th>Date</th></tr></thead>
    <tbody>
    <% recentOrders.forEach(o => { %>
        <tr onclick="window.location.href='/admin/orders/<%= o._id %>';" style="cursor:pointer;">
            <td><%= o.orderId %></td>
            <td><%= o.address?.fullName || '—' %></td>
            <td>₹<%= o.totalAmount %></td>
            <td><%= o.paymentMethod %></td>
            <td><span class="order-status <%= o.status %>"><%= o.status %></span></td>
            <td><%= new Date(o.createdAt).toLocaleDateString('en-IN') %></td>
        </tr>
    <% }) %>
    </tbody>
</table>
</div>
